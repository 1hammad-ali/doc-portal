# ==============================================================================
# GovEDMS — National Electronic Document & Records Management System
# Master Environment Variables Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL 16 Database
POSTGRES_USER=govedms_admin
POSTGRES_PASSWORD=GovSecurePassword2026!
POSTGRES_DB=govedms_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://govedms_admin:GovSecurePassword2026!@localhost:5432/govedms_production?schema=public

# Redis Cache & Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-Compatible Government Object Storage)
MINIO_ROOT_USER=govedms_minio_root
MINIO_ROOT_PASSWORD=MinioGovRootSecret2026!
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_DOCUMENTS=govedms-classified-documents

# JWT Authentication
JWT_ACCESS_SECRET=gov_edms_super_secret_jwt_access_token_key_2026_national_pmo
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=gov_edms_super_secret_jwt_refresh_token_key_2026_national_pmo
JWT_REFRESH_EXPIRATION=7d

# OCR & Barcode Microservice (Python FastAPI)
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_TIMEOUT_MS=15000
